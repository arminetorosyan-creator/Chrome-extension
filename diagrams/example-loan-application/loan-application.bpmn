          <dc:Bounds x="1142" y="477" width="66" height="16" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Decision_di" bpmnElement="Gw_Decision" isMarkerVisible="true" color:background-color="#FFF8E1" bioc:fill="#FFF8E1" color:border-color="#B7791F" bioc:stroke="#B7791F">
        <dc:Bounds x="980" y="300" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="955" y="354" width="100" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Review_di" bpmnElement="Task_Review" color:background-color="#EAF2FB" bioc:fill="#EAF2FB" color:border-color="#2F5D8A" bioc:stroke="#2F5D8A">
        <dc:Bounds x="1125" y="675" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_MergeDecision_di" bpmnElement="Gw_MergeDecision" isMarkerVisible="true" color:background-color="#FFF8E1" bioc:fill="#FFF8E1" color:border-color="#B7791F" bioc:stroke="#B7791F">
        <dc:Bounds x="1320" y="170" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyApplicant_di" bpmnElement="Task_NotifyApplicant" color:background-color="#EAF2FB" bioc:fill="#EAF2FB" color:border-color="#2F5D8A" bioc:stroke="#2F5D8A">
        <dc:Bounds x="1465" y="155" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Decided_di" bpmnElement="End_Decided" color:background-color="#ECEFF1" bioc:fill="#ECEFF1" color:border-color="#37474F" bioc:stroke="#37474F">
        <dc:Bounds x="1667" y="177" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1639" y="217" width="92" height="16" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Exception_SlaBreached_di" bpmnElement="Exception_SlaBreached" color:background-color="#FDECEA" bioc:fill="#FDECEA" color:border-color="#C62828" bioc:stroke="#C62828">
        <dc:Bounds x="855" y="347" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="893" y="385" width="90" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Store_Bureau_di" bpmnElement="Store_Bureau" color:background-color="#FFFFFF" bioc:fill="#FFFFFF" color:border-color="#546E7A" bioc:stroke="#546E7A">
        <dc:Bounds x="765" y="560" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Note_Sla_di" bpmnElement="Note_Sla" color:background-color="#FFFFFF" bioc:fill="#FFFFFF" color:border-color="#78909C" bioc:stroke="#78909C">
        <dc:Bounds x="842" y="555" width="110" height="60" />
      </bpmndi:BPMNShape>
