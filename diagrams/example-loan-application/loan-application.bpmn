<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_LoanApplication" targetNamespace="http://example.com/bpmn/loan-application">
  <bpmn:collaboration id="Collab_LoanApplication">
    <bpmn:participant id="Pool_Applicant" name="Applicant" />
    <bpmn:participant id="Pool_Lender" name="Lender" processRef="Process_Lender" />
    <bpmn:messageFlow id="Msg_Application" name="Loan application" sourceRef="Pool_Applicant" targetRef="Start_ApplicationReceived" />
    <bpmn:messageFlow id="Msg_DocsRequest" name="Document request" sourceRef="Task_RequestDocs" targetRef="Pool_Applicant" />
    <bpmn:messageFlow id="Msg_Decision" name="Decision letter" sourceRef="Task_NotifyApplicant" targetRef="Pool_Applicant" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Lender" name="Loan application handling" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Lender">
      <bpmn:lane id="Lane_Origination" name="Origination system">
        <bpmn:flowNodeRef>Start_ApplicationReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_MergeIntake</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckCompleteness</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_MergeDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyApplicant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Decided</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Underwriter" name="Underwriter">
        <bpmn:flowNodeRef>Task_Assess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Exception_SlaBreached</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Exception_Escalate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Escalated</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Manager" name="Credit manager">
        <bpmn:flowNodeRef>Task_Review</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_ApplicationReceived" name="Application received">
      <bpmn:outgoing>F1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_1" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gw_MergeIntake">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_CheckCompleteness" name="Check completeness">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gw_Complete" name="Complete?">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_RequestDocs" name="Request missing documents">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="Task_Assess" name="Assess credit risk">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:ioSpecification id="IoSpec_Assess">
        <bpmn:dataInput id="DataIn_Bureau" name="Bureau report" />
        <bpmn:inputSet id="InputSet_Assess">
          <bpmn:dataInputRefs>DataIn_Bureau</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="OutputSet_Assess" />
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="DIA_Bureau">
        <bpmn:sourceRef>Store_Bureau</bpmn:sourceRef>
        <bpmn:targetRef>DataIn_Bureau</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Exception_SlaBreached" name="2 days elapsed" cancelActivity="false" attachedToRef="Task_Assess">
      <bpmn:outgoing>F13</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_1" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Exception_Escalate" name="Escalate to team lead">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Escalated" name="Escalated">
      <bpmn:incoming>F14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gw_Decision" name="Within approval limit?">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Review" name="Review and decide">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_MergeDecision">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Task_NotifyApplicant" name="Send decision">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_Decided" name="Decision sent">
      <bpmn:incoming>F12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="Store_Bureau" name="Credit bureau" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_ApplicationReceived" targetRef="Gw_MergeIntake" />
    <bpmn:sequenceFlow id="F2" sourceRef="Gw_MergeIntake" targetRef="Task_CheckCompleteness" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_CheckCompleteness" targetRef="Gw_Complete" />
    <bpmn:sequenceFlow id="F4" name="Yes" sourceRef="Gw_Complete" targetRef="Task_Assess" />
    <bpmn:sequenceFlow id="F5" name="No" sourceRef="Gw_Complete" targetRef="Task_RequestDocs" />
    <bpmn:sequenceFlow id="F6" sourceRef="Task_RequestDocs" targetRef="Gw_MergeIntake" />
    <bpmn:sequenceFlow id="F7" sourceRef="Task_Assess" targetRef="Gw_Decision" />
    <bpmn:sequenceFlow id="F8" name="Yes" sourceRef="Gw_Decision" targetRef="Gw_MergeDecision" />
    <bpmn:sequenceFlow id="F9" name="No" sourceRef="Gw_Decision" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="F10" sourceRef="Task_Review" targetRef="Gw_MergeDecision" />
    <bpmn:sequenceFlow id="F11" sourceRef="Gw_MergeDecision" targetRef="Task_NotifyApplicant" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_NotifyApplicant" targetRef="End_Decided" />
    <bpmn:sequenceFlow id="F13" sourceRef="Exception_SlaBreached" targetRef="Exception_Escalate" />
    <bpmn:sequenceFlow id="F14" sourceRef="Exception_Escalate" targetRef="End_Escalated" />
    <bpmn:textAnnotation id="Note_Sla">
      <bpmn:text>SLA: assessment within 2 business days</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Sla" sourceRef="Task_Assess" targetRef="Note_Sla" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collab_LoanApplication">
      <bpmndi:BPMNShape id="Pool_Applicant_di" bpmnElement="Pool_Applicant" isHorizontal="true" color:background-color="#FFFFFF" bioc:fill="#FFFFFF" color:border-color="#546E7A" bioc:stroke="#546E7A">
        <dc:Bounds x="0" y="0" width="1790" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pool_Lender_di" bpmnElement="Pool_Lender" isHorizontal="true" color:background-color="#FFFFFF" bioc:fill="#FFFFFF" color:border-color="#546E7A" bioc:stroke="#546E7A">
        <dc:Bounds x="0" y="130" width="1790" height="650" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Origination_di" bpmnElement="Lane_Origination" isHorizontal="true" color:background-color="#F7F9FB" bioc:fill="#F7F9FB" color:border-color="#90A4AE" bioc:stroke="#90A4AE">
        <dc:Bounds x="30" y="130" width="1760" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Underwriter_di" bpmnElement="Lane_Underwriter" isHorizontal="true" color:background-color="#FFFFFF" bioc:fill="#FFFFFF" color:border-color="#90A4AE" bioc:stroke="#90A4AE">
        <dc:Bounds x="30" y="260" width="1760" height="390" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Manager_di" bpmnElement="Lane_Manager" isHorizontal="true" color:background-color="#F7F9FB" bioc:fill="#F7F9FB" color:border-color="#90A4AE" bioc:stroke="#90A4AE">
        <dc:Bounds x="30" y="650" width="1760" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_ApplicationReceived_di" bpmnElement="Start_ApplicationReceived" color:background-color="#E8F5E9" bioc:fill="#E8F5E9" color:border-color="#2E7D32" bioc:stroke="#2E7D32">
        <dc:Bounds x="137" y="177" width="36" height="36" />
