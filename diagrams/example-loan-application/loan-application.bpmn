      <bpmndi:BPMNShape id="End_Escalated_di" bpmnElement="End_Escalated" color:background-color="#ECEFF1" bioc:fill="#ECEFF1" color:border-color="#37474F" bioc:stroke="#37474F">
        <dc:Bounds x="1157" y="437" width="36" height="36" />
