      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RequestDocs_di" bpmnElement="Task_RequestDocs" color:background-color="#EAF2FB" bioc:fill="#EAF2FB" color:border-color="#2F5D8A" bioc:stroke="#2F5D8A">
        <dc:Bounds x="785" y="155" width="100" height="80" />
