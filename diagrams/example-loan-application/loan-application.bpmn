      <bpmndi:BPMNEdge id="DIA_Bureau_di" bpmnElement="DIA_Bureau" color:background-color="#FFFFFF" bioc:fill="#FFFFFF" color:border-color="#546E7A" bioc:stroke="#546E7A">
        <di:waypoint x="793" y="560" />
        <di:waypoint x="793" y="365" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
