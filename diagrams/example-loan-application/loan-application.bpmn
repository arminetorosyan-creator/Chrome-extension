        <dc:Bounds x="785" y="285" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Exception_Escalate_di" bpmnElement="Exception_Escalate" color:background-color="#FDECEA" bioc:fill="#FDECEA" color:border-color="#C62828" bioc:stroke="#C62828">
        <dc:Bounds x="955" y="415" width="100" height="80" />
