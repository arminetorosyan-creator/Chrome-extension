<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_ScreeningDetail" targetNamespace="http://example.com/bpmn/customer-screening-detail-steps-2-4">
  <bpmn:collaboration id="Collab_ScreeningDetail">
    <bpmn:participant id="Pool_Company" name="Company" processRef="Process_ScreeningDetail" />
    <bpmn:participant id="Pool_ListProvider" name="List provider" />
    <bpmn:messageFlow id="Msg_Lists" name="Consolidated list set" sourceRef="Pool_ListProvider" targetRef="Task_Match" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ScreeningDetail" name="Customer screening steps 2-4" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Detail">
      <bpmn:lane id="Lane_Onboarding" name="Onboarding">
        <bpmn:flowNodeRef>Start_ApplicationReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CaptureKyc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_MergeData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Exception_RequestData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_IdentifySubjects</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_MergeResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ResultReady</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Screening system">
        <bpmn:flowNodeRef>Task_Normalise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_MergeMatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Match</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Available</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_RetryLimit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Exception_RetryMatch</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Analyst" name="Compliance analyst">
        <bpmn:flowNodeRef>Exception_ManualScreen</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_ApplicationReceived" name="Application received">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_CaptureKyc" name="Capture KYC data">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_MergeData">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Validate" name="Validate attributes">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Valid" name="Attributes valid and complete?" default="F5">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Exception_RequestData" name="Request missing data">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Task_IdentifySubjects" name="Identify persons in scope">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="Task_Normalise" name="Prepare names for matching">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_MergeMatch">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Match" name="Match against lists">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Available" name="Screening service available?" default="F13">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gw_RetryLimit" name="Retry limit reached?" default="F15">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Exception_RetryMatch" name="Retry match">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Exception_ManualScreen" name="Screen manually">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_MergeResult">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_ResultReady" name="Match result ready (to step 5)">
      <bpmn:incoming>F18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start_ApplicationReceived" targetRef="Task_CaptureKyc" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_CaptureKyc" targetRef="Gw_MergeData" />
    <bpmn:sequenceFlow id="F3" sourceRef="Gw_MergeData" targetRef="Task_Validate" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_Validate" targetRef="Gw_Valid" />
    <bpmn:sequenceFlow id="F5" name="No" sourceRef="Gw_Valid" targetRef="Exception_RequestData" />
    <bpmn:sequenceFlow id="F6" sourceRef="Exception_RequestData" targetRef="Gw_MergeData" />
    <bpmn:sequenceFlow id="F7" name="Yes" sourceRef="Gw_Valid" targetRef="Task_IdentifySubjects">
      <bpmn:conditionExpression>all required attributes valid</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F8" sourceRef="Task_IdentifySubjects" targetRef="Task_Normalise" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_Normalise" targetRef="Gw_MergeMatch" />
    <bpmn:sequenceFlow id="F10" sourceRef="Gw_MergeMatch" targetRef="Task_Match" />
    <bpmn:sequenceFlow id="F11" sourceRef="Task_Match" targetRef="Gw_Available" />
    <bpmn:sequenceFlow id="F12" name="Yes" sourceRef="Gw_Available" targetRef="Gw_MergeResult">
      <bpmn:conditionExpression>service responded</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F13" name="No" sourceRef="Gw_Available" targetRef="Gw_RetryLimit" />
    <bpmn:sequenceFlow id="F14" sourceRef="Exception_RetryMatch" targetRef="Gw_MergeMatch" />
    <bpmn:sequenceFlow id="F15" name="No" sourceRef="Gw_RetryLimit" targetRef="Exception_RetryMatch" />
    <bpmn:sequenceFlow id="F16" name="Yes" sourceRef="Gw_RetryLimit" targetRef="Exception_ManualScreen">
      <bpmn:conditionExpression>retry limit reached</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F17" sourceRef="Exception_ManualScreen" targetRef="Gw_MergeResult" />
    <bpmn:sequenceFlow id="F18" sourceRef="Gw_MergeResult" targetRef="End_ResultReady" />
    <bpmn:textAnnotation id="Note_Attributes">
      <bpmn:text>Names, aliases, date of birth, nationality, address, registration number, UBOs, directors</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Attributes" sourceRef="Task_Validate" targetRef="Note_Attributes" />
    <bpmn:textAnnotation id="Note_Scope">
      <bpmn:text>Customer, UBOs, controllers, authorised signatories</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Scope" sourceRef="Task_IdentifySubjects" targetRef="Note_Scope" />
    <bpmn:textAnnotation id="Note_Names">
      <bpmn:text>Aliases and transliteration variants</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Names" sourceRef="Task_Normalise" targetRef="Note_Names" />
    <bpmn:textAnnotation id="Note_Fuzzy">
      <bpmn:text>Fuzzy and phonetic matching</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Fuzzy" sourceRef="Task_Match" targetRef="Note_Fuzzy" />
    <bpmn:textAnnotation id="Note_Limits">
      <bpmn:text>Maximum attempts and retry count: to be confirmed</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Limits" sourceRef="Gw_RetryLimit" targetRef="Note_Limits" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collab_ScreeningDetail">
      <bpmndi:BPMNShape id="Pool_Company_di" bpmnElement="Pool_Company" isHorizontal="true" color:background-color="#FFFFFF" bioc:fill="#FFFFFF" color:border-color="#546E7A" bioc:stroke="#546E7A">
        <dc:Bounds x="0" y="0" width="2470" height="780" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Onboarding_di" bpmnElement="Lane_Onboarding" isHorizontal="true" color:background-color="#F7F9FB" bioc:fill="#F7F9FB" color:border-color="#90A4AE" bioc:stroke="#90A4AE">
        <dc:Bounds x="30" y="0" width="2440" height="390" />
      </bpmndi:BPMNShape>
