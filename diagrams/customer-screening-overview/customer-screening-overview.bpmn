        <dc:Bounds x="1320" y="690" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1296" y="670" width="99" height="16" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Exception_End_Escalated_di" bpmnElement="Exception_End_Escalated" color:background-color="#FDECEA" bioc:fill="#FDECEA" color:border-color="#C62828" bioc:stroke="#C62828">
        <dc:Bounds x="1497" y="697" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1465" y="737" width="100" height="44" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
