        <dc:Bounds x="1100" y="803" width="150" height="84" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1" color:border-color="#37474F" bioc:stroke="#37474F">
        <di:waypoint x="173" y="65" />
