        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Store_AuditLog_di" bpmnElement="Store_AuditLog" color:background-color="#FFFFFF" bioc:fill="#FFFFFF" color:border-color="#546E7A" bioc:stroke="#546E7A">
