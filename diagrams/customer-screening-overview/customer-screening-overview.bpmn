        <dc:Bounds x="935" y="430" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="927" y="484" width="66" height="16" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Data_Pending_di" bpmnElement="Data_Pending" color:background-color="#FFFFFF" bioc:fill="#FFFFFF" color:border-color="#546E7A" bioc:stroke="#546E7A">
        <dc:Bounds x="1032" y="430" width="36" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1015" y="484" width="70" height="44" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Note_Pending_di" bpmnElement="Note_Pending" color:background-color="#FFFFFF" bioc:fill="#FFFFFF" color:border-color="#78909C" bioc:stroke="#78909C">
        <dc:Bounds x="930" y="557" width="150" height="56" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Note_Collect_di" bpmnElement="Note_Collect" color:background-color="#FFFFFF" bioc:fill="#FFFFFF" color:border-color="#78909C" bioc:stroke="#78909C">
        <dc:Bounds x="250" y="153" width="150" height="84" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Note_Scope_di" bpmnElement="Note_Scope" color:background-color="#FFFFFF" bioc:fill="#FFFFFF" color:border-color="#78909C" bioc:stroke="#78909C">
        <dc:Bounds x="420" y="167" width="150" height="56" />
      </bpmndi:BPMNShape>
