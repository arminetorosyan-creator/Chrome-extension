        <di:waypoint x="580" y="65" />
        <di:waypoint x="580" y="325" />
        <di:waypoint x="615" y="325" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4" color:border-color="#37474F" bioc:stroke="#37474F">
        <di:waypoint x="715" y="325" />
        <di:waypoint x="810" y="325" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5" color:border-color="#37474F" bioc:stroke="#37474F">
        <di:waypoint x="835" y="300" />
        <di:waypoint x="835" y="65" />
        <di:waypoint x="955" y="65" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="841" y="280" width="24" height="16" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6" color:border-color="#37474F" bioc:stroke="#37474F">
        <di:waypoint x="860" y="325" />
        <di:waypoint x="955" y="325" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="864" y="306" width="26" height="16" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7" color:border-color="#37474F" bioc:stroke="#37474F">
        <di:waypoint x="1055" y="65" />
        <di:waypoint x="1157" y="65" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8" color:border-color="#37474F" bioc:stroke="#37474F">
        <di:waypoint x="1055" y="325" />
        <di:waypoint x="1090" y="325" />
        <di:waypoint x="1090" y="715" />
        <di:waypoint x="1125" y="715" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9" color:border-color="#37474F" bioc:stroke="#37474F">
        <di:waypoint x="1225" y="715" />
        <di:waypoint x="1320" y="715" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10" color:background-color="#FDECEA" bioc:fill="#FDECEA" color:border-color="#C62828" bioc:stroke="#C62828">
        <di:waypoint x="1370" y="715" />
        <di:waypoint x="1497" y="715" />
        <bpmndi:BPMNLabel>
