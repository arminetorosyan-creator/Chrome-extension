<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_ScreeningOverview" targetNamespace="http://example.com/bpmn/customer-screening-overview">
  <bpmn:collaboration id="Collab_ScreeningOverview">
    <bpmn:participant id="Pool_Company" name="Company" processRef="Process_Screening" />
    <bpmn:participant id="Pool_ListProvider" name="List provider" />
    <bpmn:participant id="Pool_AlertHandling" name="Alert Handling" />
    <bpmn:messageFlow id="Msg_Lists" name="Consolidated list set" sourceRef="Pool_ListProvider" targetRef="Task_RunMatch" />
    <bpmn:messageFlow id="Msg_Handoff" name="Alert and ownership result" sourceRef="Task_HandOff" targetRef="Pool_AlertHandling" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Screening" name="Customer screening" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Screening">
      <bpmn:lane id="Lane_Onboarding" name="Onboarding">
        <bpmn:flowNodeRef>Start_ApplicationReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectValidate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DetermineScope</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordClear</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Clear</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Screening system">
        <bpmn:flowNodeRef>Task_RunMatch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Match</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CreateAlert</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Analyst" name="Compliance analyst">
        <bpmn:flowNodeRef>Task_CheckOwnership</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_Threshold</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Exception_End_Escalated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HandOff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_AlertRaised</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_ApplicationReceived" name="Application received">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_CollectValidate" name="Collect and validate data">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Task_DetermineScope" name="Determine screening scope">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="Task_RunMatch" name="Run automated match">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_Match" name="Potential match?" default="F5">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_RecordClear" name="Record clear result">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:ioSpecification id="IoSpec_RecordClear">
        <bpmn:dataOutput id="DataOut_ClearLog" name="Clear result" />
        <bpmn:inputSet id="InputSet_RecordClear" />
        <bpmn:outputSet id="OutputSet_RecordClear">
          <bpmn:dataOutputRefs>DataOut_ClearLog</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="DOA_ClearLog">
        <bpmn:sourceRef>DataOut_ClearLog</bpmn:sourceRef>
        <bpmn:targetRef>Store_AuditLog</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:endEvent id="End_Clear" name="Clear – onboarding continues">
      <bpmn:incoming>F7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_CreateAlert" name="Create alert">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
      <bpmn:ioSpecification id="IoSpec_CreateAlert">
        <bpmn:dataOutput id="DataOut_AlertLog" name="Alert record" />
        <bpmn:dataOutput id="DataOut_Status" name="Account status" />
        <bpmn:inputSet id="InputSet_CreateAlert" />
        <bpmn:outputSet id="OutputSet_CreateAlert">
          <bpmn:dataOutputRefs>DataOut_AlertLog</bpmn:dataOutputRefs>
          <bpmn:dataOutputRefs>DataOut_Status</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="DOA_Status">
        <bpmn:sourceRef>DataOut_Status</bpmn:sourceRef>
        <bpmn:targetRef>Data_Pending</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="DOA_AlertLog">
        <bpmn:sourceRef>DataOut_AlertLog</bpmn:sourceRef>
        <bpmn:targetRef>Store_AuditLogAlert</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_CheckOwnership" name="Check ownership">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_Threshold" name="Threshold met?" default="F11">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Exception_End_Escalated" name="Escalated (ownership threshold met)">
      <bpmn:incoming>F10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_HandOff" name="Hand off to Alert Handling">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_AlertRaised" name="Alert raised – handed to Alert Handling">
      <bpmn:incoming>F12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="Store_AuditLog" name="Audit log" />
    <bpmn:dataStoreReference id="Store_AuditLogAlert" name="Audit log" />
    <bpmn:dataObject id="DataObj_Pending" name="Account status: Pending" />
    <bpmn:dataObjectReference id="Data_Pending" name="Account status: Pending" dataObjectRef="DataObj_Pending" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start_ApplicationReceived" targetRef="Task_CollectValidate" />
    <bpmn:sequenceFlow id="F2" sourceRef="Task_CollectValidate" targetRef="Task_DetermineScope" />
    <bpmn:sequenceFlow id="F3" sourceRef="Task_DetermineScope" targetRef="Task_RunMatch" />
    <bpmn:sequenceFlow id="F4" sourceRef="Task_RunMatch" targetRef="Gw_Match" />
    <bpmn:sequenceFlow id="F5" name="No" sourceRef="Gw_Match" targetRef="Task_RecordClear" />
    <bpmn:sequenceFlow id="F6" name="Yes" sourceRef="Gw_Match" targetRef="Task_CreateAlert">
      <bpmn:conditionExpression>potential match found</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F7" sourceRef="Task_RecordClear" targetRef="End_Clear" />
    <bpmn:sequenceFlow id="F8" sourceRef="Task_CreateAlert" targetRef="Task_CheckOwnership" />
    <bpmn:sequenceFlow id="F9" sourceRef="Task_CheckOwnership" targetRef="Gw_Threshold" />
    <bpmn:sequenceFlow id="F10" name="Yes" sourceRef="Gw_Threshold" targetRef="Exception_End_Escalated">
      <bpmn:conditionExpression>aggregate stakes at or above threshold</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F11" name="No" sourceRef="Gw_Threshold" targetRef="Task_HandOff" />
    <bpmn:sequenceFlow id="F12" sourceRef="Task_HandOff" targetRef="End_AlertRaised" />
    <bpmn:textAnnotation id="Note_Collect">
      <bpmn:text>Names, aliases, date of birth, nationality, address, registration number, UBOs, directors</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Collect" sourceRef="Task_CollectValidate" targetRef="Note_Collect" />
    <bpmn:textAnnotation id="Note_Scope">
      <bpmn:text>Customer, UBOs, controllers, authorised signatories</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Scope" sourceRef="Task_DetermineScope" targetRef="Note_Scope" />
    <bpmn:textAnnotation id="Note_Match">
      <bpmn:text>Fuzzy and phonetic matching with transliteration</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Match" sourceRef="Task_RunMatch" targetRef="Note_Match" />
    <bpmn:textAnnotation id="Note_Pending">
      <bpmn:text>Account not activated while hit unresolved</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Pending" sourceRef="Task_CreateAlert" targetRef="Note_Pending" />
    <bpmn:textAnnotation id="Note_Ownership">
      <bpmn:text>Aggregate stakes of listed persons; escalate if the threshold is met (threshold to be confirmed)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Ownership" sourceRef="Task_CheckOwnership" targetRef="Note_Ownership" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collab_ScreeningOverview">
      <bpmndi:BPMNShape id="Pool_Company_di" bpmnElement="Pool_Company" isHorizontal="true" color:background-color="#FFFFFF" bioc:fill="#FFFFFF" color:border-color="#546E7A" bioc:stroke="#546E7A">
        <dc:Bounds x="0" y="0" width="1790" height="910" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Onboarding_di" bpmnElement="Lane_Onboarding" isHorizontal="true" color:background-color="#F7F9FB" bioc:fill="#F7F9FB" color:border-color="#90A4AE" bioc:stroke="#90A4AE">
        <dc:Bounds x="30" y="0" width="1760" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true" color:background-color="#FFFFFF" bioc:fill="#FFFFFF" color:border-color="#90A4AE" bioc:stroke="#90A4AE">
        <dc:Bounds x="30" y="260" width="1760" height="390" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Analyst_di" bpmnElement="Lane_Analyst" isHorizontal="true" color:background-color="#F7F9FB" bioc:fill="#F7F9FB" color:border-color="#90A4AE" bioc:stroke="#90A4AE">
        <dc:Bounds x="30" y="650" width="1760" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pool_ListProvider_di" bpmnElement="Pool_ListProvider" isHorizontal="true" color:background-color="#FFFFFF" bioc:fill="#FFFFFF" color:border-color="#546E7A" bioc:stroke="#546E7A">
        <dc:Bounds x="0" y="970" width="1790" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Pool_AlertHandling_di" bpmnElement="Pool_AlertHandling" isHorizontal="true" color:background-color="#FFFFFF" bioc:fill="#FFFFFF" color:border-color="#546E7A" bioc:stroke="#546E7A">
        <dc:Bounds x="0" y="1100" width="1790" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_ApplicationReceived_di" bpmnElement="Start_ApplicationReceived" color:background-color="#E8F5E9" bioc:fill="#E8F5E9" color:border-color="#2E7D32" bioc:stroke="#2E7D32">
        <dc:Bounds x="137" y="47" width="36" height="36" />
