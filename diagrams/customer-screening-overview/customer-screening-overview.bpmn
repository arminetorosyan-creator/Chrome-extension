          <dc:Bounds x="105" y="87" width="100" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CollectValidate_di" bpmnElement="Task_CollectValidate" color:background-color="#EAF2FB" bioc:fill="#EAF2FB" color:border-color="#2F5D8A" bioc:stroke="#2F5D8A">
        <dc:Bounds x="275" y="25" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DetermineScope_di" bpmnElement="Task_DetermineScope" color:background-color="#EAF2FB" bioc:fill="#EAF2FB" color:border-color="#2F5D8A" bioc:stroke="#2F5D8A">
        <dc:Bounds x="445" y="25" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RunMatch_di" bpmnElement="Task_RunMatch" color:background-color="#EAF2FB" bioc:fill="#EAF2FB" color:border-color="#2F5D8A" bioc:stroke="#2F5D8A">
        <dc:Bounds x="615" y="285" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Match_di" bpmnElement="Gw_Match" isMarkerVisible="true" color:background-color="#FFF8E1" bioc:fill="#FFF8E1" color:border-color="#B7791F" bioc:stroke="#B7791F">
        <dc:Bounds x="810" y="300" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="785" y="354" width="100" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RecordClear_di" bpmnElement="Task_RecordClear" color:background-color="#EAF2FB" bioc:fill="#EAF2FB" color:border-color="#2F5D8A" bioc:stroke="#2F5D8A">
        <dc:Bounds x="955" y="25" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Clear_di" bpmnElement="End_Clear" color:background-color="#ECEFF1" bioc:fill="#ECEFF1" color:border-color="#37474F" bioc:stroke="#37474F">
        <dc:Bounds x="1157" y="47" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1125" y="87" width="100" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CreateAlert_di" bpmnElement="Task_CreateAlert" color:background-color="#EAF2FB" bioc:fill="#EAF2FB" color:border-color="#2F5D8A" bioc:stroke="#2F5D8A">
        <dc:Bounds x="955" y="285" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckOwnership_di" bpmnElement="Task_CheckOwnership" color:background-color="#EAF2FB" bioc:fill="#EAF2FB" color:border-color="#2F5D8A" bioc:stroke="#2F5D8A">
        <dc:Bounds x="1125" y="675" width="100" height="80" />
      </bpmndi:BPMNShape>
